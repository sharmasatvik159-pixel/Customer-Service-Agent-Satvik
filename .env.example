ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
HOST=0.0.0.0
WORKERS=4

SECRET_KEY=nexbank-insecure-dev-secret-replace-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
KMS_MASTER_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/sample-kms-key-id
ENCRYPTION_SALT=nexbank-customer-data-salt-random-entropy

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexbank_ai_cs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexbank_ai_cs

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=nexbank-customer-service
TEMPORAL_TASK_QUEUE=nexbank-agent-queue

PRIMARY_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-3.5-turbo

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b-instruct-q8_0

VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIRECTORY=./data/chromadb
CHROMA_COLLECTION_NAME=nexbank_knowledge_base

PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxx
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=nexbank-banking-rag

RASA_ENDPOINT=http://localhost:5005
RASA_MODEL_PATH=./models/rasa/current

GUARDRAIL_STRICT_MODE=true
ENABLE_PII_MASKING=true
PRESIDIO_ANALYZER_CONF=./config/presidio-analyzer.yaml
MAX_ADVICE_DISCLAIMER_REQUIRED=true

CRM_ESCALATION_WEBHOOK_URL=https://crm.internal.nexbank.com/api/v1/escalations
AGENT_DESKTOP_WEBSOCKET_URL=wss://desktop.internal.nexbank.com/ws/agent-inbox

ENABLE_OPENTELEMETRY=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
PROMETHEUS_METRICS_PORT=9090
